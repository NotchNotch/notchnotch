<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Intentionally empty. Extension helpers are spawned with responsibility
	     disclaimed, so each helper requests privacy permissions (Automation,
	     Calendars, ...) with its own bundle's entitlements and usage strings.
	     Adding one here would grant nothing to helpers. -->
</dict>
</plist>
