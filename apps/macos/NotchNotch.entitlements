<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The calendar and now-playing capabilities read Calendar and control
	     Spotify and Apple Music from inside NotchNotch, so macOS checks these
	     entitlements and the usage descriptions in the app's Info.plist.
	     Helpers of installed extensions are their own TCC subject. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
