{
  "name": "@notchnotch/runtime",
  "version": "0.8.0",
  "description": "Starts a NotchNotch extension inside the app's JavaScriptCore runtime.",
  "license": "MIT",
  "author": "AmirHossein Sadeghi",
  "homepage": "https://github.com/NotchNotch/notchnotch/blob/main/docs/README.md",
  "bugs": "https://github.com/NotchNotch/notchnotch/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NotchNotch/notchnotch.git",
    "directory": "packages/runtime"
  },
  "keywords": [
    "notchnotch",
    "macos",
    "notch",
    "extension"
  ],
  "type": "module",
  "exports": "./src/index.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts",
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@notchnotch/react-renderer": "workspace:*",
    "@notchnotch/protocol": "workspace:*"
  },
  "peerDependencies": {
    "react": "~19.3.1"
  }
}
