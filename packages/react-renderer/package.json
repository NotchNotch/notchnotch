{
  "name": "@notchnotch/react-renderer",
  "version": "0.11.0",
  "description": "React renderer that turns NotchNotch extension components into native UI snapshots.",
  "license": "MIT",
  "author": "AmirHossein Sadeghi",
  "homepage": "https://github.com/NotchNotch/notchnotch/blob/main/docs/README.md",
  "bugs": "https://github.com/NotchNotch/notchnotch/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NotchNotch/notchnotch.git",
    "directory": "packages/react-renderer"
  },
  "keywords": [
    "notchnotch",
    "macos",
    "notch",
    "extension"
  ],
  "type": "module",
  "exports": "./src/index.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts",
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "react-reconciler": "0.34.0",
    "@notchnotch/protocol": "workspace:*"
  },
  "peerDependencies": {
    "react": "~19.3.1"
  }
}
