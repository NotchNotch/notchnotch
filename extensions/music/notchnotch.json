{
  "id": "dev.notchnotch.music",
  "name": "Music",
  "version": "0.8.1",
  "apiVersion": 1,
  "entry": "bundle.js",
  "permissions": [
    "process"
  ],
  "connections": {
    "player": {
      "transport": "stdio",
      "executable": "./helpers/MusicAdapter.app/Contents/MacOS/MusicAdapter",
      "arguments": []
    }
  },
  "icon": "icon.png",
  "description": "Your music, a glance away. Playback controls for Spotify and Apple Music.",
  "imageHosts": [
    "i.scdn.co",
    "mosaic.scdn.co",
    "*.mzstatic.com"
  ],
  "author": "sadeqi-ah",
  "categories": ["Media"],
  "license": "GPL-3.0-only",
  "repository": "https://github.com/NotchNotch/notchnotch/tree/main/extensions/music"
}
