{
  "id": "dev.notchnotch.calendar",
  "name": "Calendar",
  "version": "0.8.0",
  "apiVersion": 1,
  "entry": "bundle.js",
  "permissions": ["process"],
  "connections": {
    "calendar": {
      "transport": "stdio",
      "executable": "./helpers/CalendarAdapter.app/Contents/MacOS/CalendarAdapter",
      "arguments": []
    }
  },
  "icon": "icon.png",
  "description": "Your next event, with a live countdown and meeting controls. Connect the calendars already on your Mac.",
  "author": "sadeqi-ah",
  "categories": ["Productivity"],
  "license": "GPL-3.0-only",
  "repository": "https://github.com/sadeqi-ah/notchnotch/tree/main/extensions/calendar"
}
