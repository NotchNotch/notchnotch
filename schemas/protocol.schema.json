{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NotchNotch snapshot v1",
  "description": "A snapshot an extension sends after each render: everything it shows in the notch and its Settings page.",
  "x-name": "Snapshot",
  "type": "object",
  "required": [
    "protocolVersion",
    "type",
    "extensionID",
    "revision",
    "surfaces"
  ],
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "type": {
      "const": "snapshot"
    },
    "extensionID": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Increases with every snapshot from the same runner."
    },
    "surfaces": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "settings": {
      "$ref": "#/$defs/settingsNode"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "surface": {
      "x-name": "Surface",
      "type": "object",
      "required": [
        "id",
        "kind",
        "title",
        "initialView",
        "phase",
        "expanded"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "x-name": "SurfaceKind",
          "enum": [
            "activity",
            "prompt"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "initialView": {
          "x-name": "Presentation",
          "enum": [
            "compact",
            "expanded"
          ],
          "default": "compact"
        },
        "phase": {
          "x-name": "SurfacePhase",
          "enum": [
            "active",
            "paused",
            "completed",
            "pending"
          ],
          "default": "active"
        },
        "compact": {
          "x-name": "CompactContent",
          "type": "object",
          "required": [
            "leading",
            "trailing"
          ],
          "properties": {
            "leading": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            },
            "trailing": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          },
          "additionalProperties": false
        },
        "expanded": {
          "$ref": "#/$defs/node"
        },
        "peek": {
          "x-name": "PeekContent",
          "type": "object",
          "required": [
            "id",
            "text",
            "duration"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "Change for each new event; keep stable during routine renders."
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "duration": {
              "type": "number",
              "minimum": 1,
              "maximum": 10,
              "default": 4
            }
          },
          "additionalProperties": false,
          "description": "A short announcement. A new id announces a new event; ordinary snapshots keep the same id."
        },
        "tile": {
          "x-name": "TileContent",
          "type": "object",
          "required": [
            "size",
            "content"
          ],
          "properties": {
            "size": {
              "x-name": "TileSize",
              "x-swift-unknown": "unknown",
              "enum": [
                "small",
                "wide"
              ],
              "default": "small",
              "description": "small fills one cell of Home's four-column grid, wide fills two. The user can change it."
            },
            "content": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          },
          "additionalProperties": false,
          "description": "The activity's tile in Home. Readings only: no buttons or fields, the whole tile opens the activity. Without one, Home builds the tile from compact and title."
        },
        "idlePreview": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "initialView": {
                "const": "compact"
              }
            }
          },
          "then": {
            "required": [
              "compact"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "prompt"
              }
            }
          },
          "then": {
            "properties": {
              "phase": {
                "const": "pending"
              }
            }
          },
          "else": {
            "properties": {
              "phase": {
                "enum": [
                  "active",
                  "paused",
                  "completed"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "peek"
            ]
          },
          "then": {
            "required": [
              "compact"
            ],
            "properties": {
              "kind": {
                "const": "activity"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "idlePreview"
            ],
            "properties": {
              "idlePreview": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "compact"
            ],
            "properties": {
              "kind": {
                "const": "activity"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "tile"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "const": "activity"
              }
            }
          }
        }
      ],
      "additionalProperties": false,
      "x-swift-conforms": [
        "Identifiable"
      ]
    },
    "node": {
      "x-name": "UINode",
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "x-swift-name": "NodeKind",
          "x-swift-unknown": "unknown",
          "enum": [
            "column",
            "row",
            "text",
            "symbol",
            "progress",
            "button",
            "textField",
            "artwork",
            "waveform",
            "player",
            "spacer",
            "divider",
            "toggle",
            "section",
            "listItem",
            "badge",
            "picker",
            "value",
            "ring"
          ],
          "x-ts-name": "NodeType"
        },
        "props": {
          "x-name": "NodeProps",
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 4096
            },
            "name": {
              "type": "string",
              "maxLength": 128
            },
            "tone": {
              "x-name": "Tone",
              "enum": [
                "primary",
                "secondary",
                "accent",
                "success",
                "warning",
                "danger"
              ]
            },
            "size": {
              "x-name": "TextSize",
              "enum": [
                "caption",
                "body",
                "headline",
                "title",
                "timer"
              ]
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Progress or a Ring's fill, from zero to one."
            },
            "action": {
              "type": "string",
              "maxLength": 128
            },
            "placeholder": {
              "type": "string"
            },
            "disabled": {
              "type": "boolean"
            },
            "source": {
              "type": "string",
              "maxLength": 65536
            },
            "media": {
              "$ref": "#/$defs/nowPlaying"
            },
            "detail": {
              "type": "string",
              "maxLength": 4096,
              "description": "Secondary line: list item subtitle or section footer."
            },
            "unit": {
              "type": "string",
              "maxLength": 32,
              "description": "What a Value's number counts, drawn small beside it: min, %, mmhg."
            },
            "spacing": {
              "x-name": "Spacing",
              "enum": [
                "none",
                "tight",
                "regular",
                "loose"
              ]
            },
            "align": {
              "x-swift-name": "LayoutAlignment",
              "enum": [
                "start",
                "center",
                "end"
              ],
              "x-ts-name": "Alignment"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "x-name": "PickerOption",
                "type": "object",
                "required": [
                  "value",
                  "label"
                ],
                "additionalProperties": false,
                "properties": {
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 128
                  }
                },
                "x-swift-conforms": [
                  "Hashable"
                ]
              },
              "description": "Picker choices; `selection` holds the chosen value."
            },
            "selection": {
              "type": "string",
              "maxLength": 128
            },
            "label": {
              "type": "string",
              "maxLength": 256,
              "description": "What VoiceOver says for a symbol, an icon-only button, a progress bar or a field."
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "x-swift-conforms": [
        "Identifiable"
      ]
    },
    "nowPlaying": {
      "x-name": "NowPlayingState",
      "type": "object",
      "required": [
        "id",
        "eventID",
        "player",
        "title",
        "artist",
        "album",
        "duration",
        "position",
        "isPlaying",
        "volume",
        "shuffle",
        "repeating",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "eventID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "player": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "playerName": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "artist": {
          "type": "string",
          "maxLength": 256
        },
        "album": {
          "type": "string",
          "maxLength": 256,
          "default": ""
        },
        "artwork": {
          "type": "string",
          "maxLength": 65536,
          "description": "Bounded JPEG/PNG data or an https URL on a host the extension lists in `imageHosts`."
        },
        "duration": {
          "type": "number",
          "minimum": 0,
          "maximum": 604800
        },
        "position": {
          "type": "number",
          "minimum": 0,
          "maximum": 604800
        },
        "isPlaying": {
          "type": "boolean"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "shuffle": {
          "type": "boolean",
          "default": false
        },
        "repeating": {
          "type": "boolean",
          "default": false
        },
        "updatedAt": {
          "type": "number",
          "x-swift-default": "Date.now.timeIntervalSince1970",
          "description": "Seconds since 1970 when `position` was read."
        }
      },
      "additionalProperties": false
    },
    "settingsNode": {
      "allOf": [
        {
          "$ref": "#/$defs/node"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "column",
                "row",
                "text",
                "symbol",
                "progress",
                "button",
                "textField",
                "spacer",
                "divider",
                "toggle",
                "section",
                "listItem",
                "badge",
                "picker"
              ]
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/settingsNode"
              }
            }
          }
        }
      ]
    },
    "userEvent": {
      "x-name": "UserEvent",
      "description": "A tap, toggle or text the user sent to an extension.",
      "type": "object",
      "required": [
        "protocolVersion",
        "type",
        "action"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "type": {
          "const": "event"
        },
        "action": {
          "type": "string",
          "maxLength": 128
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
