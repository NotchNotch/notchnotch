{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NotchNotch extension manifest v1 preview",
  "x-name": "ExtensionManifest",
  "description": "notchnotch.json: what an extension is, what it may reach and the settings it asks for.",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "apiVersion",
    "entry",
    "permissions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "apiVersion": {
      "const": 1
    },
    "entry": {
      "const": "bundle.js"
    },
    "permissions": {
      "type": "array",
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "x-swift-type": "String",
        "enum": [
          "local-network",
          "process",
          "file-read",
          "calendar",
          "now-playing",
          "battery",
          "system"
        ]
      },
      "description": "`local-network` for loopback HTTP and WebSocket connections, `process` for native helpers, `calendar`, `now-playing`, `battery` and `system` for the app's system capabilities, `file-read` to read and save the files dropped on the extension."
    },
    "connections": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/connection"
      },
      "description": "Named local destinations: loopback HTTP or WebSocket services and native helpers."
    },
    "accent": {
      "x-swift-type": "String",
      "enum": [
        "orange",
        "yellow",
        "green",
        "mint",
        "cyan",
        "blue",
        "purple",
        "pink",
        "red"
      ],
      "x-ts-name": "AccentColorName",
      "x-swift-list": "AccentColor.all",
      "description": "The extension's color in the notch: progress bars, its main button and anything with tone \"accent\". The app draws each name in a shade tuned for the black notch. Without one, accents are white."
    },
    "icon": {
      "type": "string",
      "maxLength": 128,
      "description": "An SF Symbol name, or the file name of a 512×512 PNG in the package's assets/ folder (such as icon.png).",
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,99}\\.png$"
        },
        {
          "not": {
            "pattern": "\\.png$"
          }
        }
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 512
    },
    "imageHosts": {
      "description": "HTTPS hosts the app may fetch Artwork from for this extension. An exact DNS name or a *.subdomain wildcard (which does not match the bare domain).",
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 253,
        "pattern": "^(\\*\\.)?([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
      }
    },
    "network": {
      "description": "HTTPS hosts the extension may reach with fetch. An exact DNS name or a *.subdomain wildcard (which does not match the bare domain).",
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 253,
        "pattern": "^(\\*\\.)?([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
      }
    },
    "preferences": {
      "description": "Settings NotchNotch asks for, stores and draws natively in Setup. Values reach the extension through getPreferenceValues().",
      "type": "array",
      "maxItems": 16,
      "items": {
        "x-name": "ExtensionPreference",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "title"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"
          },
          "type": {
            "x-name": "PreferenceKind",
            "enum": [
              "text",
              "password",
              "toggle",
              "dropdown"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "description": {
            "type": "string",
            "maxLength": 256
          },
          "placeholder": {
            "type": "string",
            "maxLength": 128
          },
          "required": {
            "type": "boolean"
          },
          "default": {
            "x-swift-type": "JSONValue",
            "type": [
              "string",
              "boolean"
            ]
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "x-name": "PreferenceOption",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "title"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              }
            },
            "description": "Choices for a dropdown."
          }
        },
        "description": "One setting declared in the manifest. The app stores its value, draws the field in Setup and hands the values to the extension when it starts."
      }
    },
    "author": {
      "description": "Store handle of the publisher, such as a GitHub user name.",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,37}[a-z0-9])?$"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "x-swift-type": "String",
        "enum": [
          "Communication",
          "Developer Tools",
          "Finance",
          "Fun",
          "Health",
          "Media",
          "News",
          "Productivity",
          "Sports",
          "System",
          "Weather",
          "Other"
        ],
        "x-ts-name": "ExtensionCategoryName",
        "x-swift-list": "ExtensionCategory.all"
      },
      "description": "One to three entries from `ExtensionCategory.all`."
    },
    "homepage": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://"
    },
    "repository": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://"
    },
    "license": {
      "description": "An SPDX license expression, such as MIT.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9.+-]+( (AND|OR|WITH) [A-Za-z0-9.+-]+)*$"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "connection": {
      "x-name": "ConnectionDefinition",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "transport",
            "endpoint"
          ],
          "properties": {
            "transport": {
              "const": "http"
            },
            "endpoint": {
              "type": "string",
              "pattern": "^https?://(127\\.0\\.0\\.1|\\[::1\\]):[0-9]+/?$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "transport",
            "endpoint"
          ],
          "properties": {
            "transport": {
              "const": "websocket"
            },
            "endpoint": {
              "type": "string",
              "pattern": "^wss?://(127\\.0\\.0\\.1|\\[::1\\]):[0-9]+(/[^?#]*)?$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "transport",
            "executable"
          ],
          "properties": {
            "transport": {
              "const": "stdio"
            },
            "executable": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "arguments": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "maxLength": 4096
              }
            }
          },
          "additionalProperties": false
        }
      ],
      "x-discriminator-name": "ConnectionTransport",
      "description": "A declared local destination: a loopback HTTP or WebSocket service, or a native helper started over stdio."
    }
  }
}
