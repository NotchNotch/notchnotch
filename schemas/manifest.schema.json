{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NotchNotch extension manifest v1 preview",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "apiVersion",
    "entry",
    "permissions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "apiVersion": {
      "const": 1
    },
    "entry": {
      "const": "bundle.js"
    },
    "permissions": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "local-network",
          "process"
        ]
      }
    },
    "connections": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/connection"
      }
    },
    "icon": {
      "type": "string",
      "maxLength": 128,
      "description": "An SF Symbol name, or the file name of a 512×512 PNG in the package's assets/ folder (such as icon.png). An optional name@dark.png beside it is used on dark backgrounds.",
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,99}\\.png$"
        },
        {
          "not": {
            "pattern": "\\.png$"
          }
        }
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 512
    },
    "imageHosts": {
      "description": "HTTPS hosts the app may load Artwork from. An exact DNS name or a *.subdomain wildcard (which does not match the bare domain).",
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 253,
        "pattern": "^(\\*\\.)?([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
      }
    },
    "author": {
      "description": "Store handle of the publisher, such as a GitHub user name.",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,37}[a-z0-9])?$"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "Communication",
          "Developer Tools",
          "Finance",
          "Fun",
          "Health",
          "Media",
          "News",
          "Productivity",
          "Sports",
          "System",
          "Weather",
          "Other"
        ]
      }
    },
    "homepage": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://"
    },
    "repository": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://"
    },
    "license": {
      "description": "An SPDX license expression, such as MIT.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9.+-]+( (AND|OR|WITH) [A-Za-z0-9.+-]+)*$"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "connection": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "transport",
            "endpoint"
          ],
          "properties": {
            "transport": {
              "const": "http"
            },
            "endpoint": {
              "type": "string",
              "pattern": "^https?://(127\\.0\\.0\\.1|\\[::1\\]):[0-9]+/?$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "transport",
            "endpoint"
          ],
          "properties": {
            "transport": {
              "const": "websocket"
            },
            "endpoint": {
              "type": "string",
              "pattern": "^wss?://(127\\.0\\.0\\.1|\\[::1\\]):[0-9]+(/[^?#]*)?$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "transport",
            "executable"
          ],
          "properties": {
            "transport": {
              "const": "stdio"
            },
            "executable": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "arguments": {
              "type": "array",
              "maxItems": 22,
              "items": {
                "type": "string",
                "maxLength": 4096
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
